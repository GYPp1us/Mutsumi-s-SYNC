# Private /opt/mutsumi-sync-v4/shared/qqbot.env, root:root 0600.
# Never share the model credential or WebUI access key with this process.
QQBOT_APP_ID=YOUR_APP_ID
QQBOT_APP_SECRET=YOUR_APP_SECRET
# Generate a separate random secret; same value in the Rust service environment.
MUTSUMI_QQBOT_BRIDGE_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
QQBOT_INGRESS_URL=http://127.0.0.1:18240/qqbot/events
QQBOT_BRIDGE_PORT=18241
QQBOT_STATE_DIR=/var/lib/mutsumi-qqbot
